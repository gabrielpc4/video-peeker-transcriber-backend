.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/

# SwiftPM
.build/
.swiftpm/

# Fastlane / packaging
*.ipa
*.dSYM
*.dSYM.zip

# Backend secrets + runtime data
## WARNING: secrets are committed by explicit user request.
## (Not recommended for real projects.)
## backend/.env
## backend/secrets/*
## !backend/secrets/README.md
backend/secrets/*.bak
backend/storage/
backend/*.sqlite
backend/*.sqlite-wal
backend/*.sqlite-shm

# Backend persistent data (VPS keeps its own)
backend/data/

# Python cache
**/__pycache__/
**/*.pyc

